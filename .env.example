# Variables exposées au navigateur (préfixe VITE_ obligatoire).
# Copier ce fichier vers .env.local (dev) et renseigner les valeurs du projet
# PostHog : Project settings -> Project API key.

# Clé publique PostHog (commence par "phc_"). Sans elle, l'analytique est
# simplement désactivée : l'application fonctionne normalement.
VITE_POSTHOG_KEY=

# Ingestion : https://us.i.posthog.com (US, par défaut) ou https://eu.i.posthog.com (EU).
VITE_POSTHOG_HOST=https://us.i.posthog.com
